{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "servers": {
            "ck": {
                "type": "local",
                "command": ["ck", "--serve"],
                "codemode": false
            },
            "linear": {
                "type": "remote",
                "url": "https://mcp.linear.app/mcp",
                "codemode": false
            }
        }
    },
    "providers": {
        "openai": { "settings": { "timeout": 1800000 } },
        "zai-coding-plan": { "settings": { "timeout": 1800000 } }
    },
    "experimental": {
        "todo": true,
        "subagent_depth": 2
    },
    "permissions": [
        { "action": "external_directory", "resource": "*", "effect": "ask" }
    ]
}
